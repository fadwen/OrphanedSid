# Run output. Every command writes a log under .\Logs and Remove-OrphanedSid writes backups under
# .\Backup relative to the current directory, which during development is the repository root.
# Both name real objects from whatever domain the module was last run against.
Logs/
Backup/

# Pester / coverage output
coverage.xml
testResults.xml
*.trx
Tests/Scripts/
Tests/Logs/
Tests/Results/
test*.xml

# Publish staging tree. Build/Publish-Module.ps1 wipes and rebuilds this on every run; it holds
# only copies of files that are tracked elsewhere.
out/

# PlatyPS build intermediate. The Markdown under docs/ is the source and the packaged help is
# en-US/OrphanedSid-Help.xml; maml/ is the staging folder Export-MamlCommandHelp writes to.
maml/

# Update-MarkdownCommandHelp writes these next to the originals.
*.md.bak

# Lab seeding output from Tools/Generate-OrphanedSIDs.ps1
OrphanedSID_Generation*

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
